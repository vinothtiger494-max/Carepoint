# Server port (platforms like Railway/Render inject PORT automatically)
PORT=5000

# Node environment: development | production
NODE_ENV=production

# MongoDB Atlas connection string (required in production).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/carepoint?retryWrites=true&w=majority
MONGO_URI=

# JWT signing secret - REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated allowed front-end origins for CORS.
# If the client is served by this same server, the request origin still
# must be listed here. Use your production domain(s):
CLIENT_URL=https://yourdomain.com

# Optional: password for the seeded admin account (default: Admin@123 - CHANGE THIS)
# SEED_ADMIN_PASSWORD=choose-a-strong-password
